# Copy to .env for local dev; set in the Render dashboard for production. Never commit the real key.
# Used by server.ts to draft essays. Set a hard monthly spend cap in the Anthropic console too.
ANTHROPIC_API_KEY=sk-ant-...

# Shared bearer token gating /api/*. Without it server.ts refuses to serve the API at all.
# Generate one with:  openssl rand -hex 32
# Set the SAME value as VITE_APP_TOKEN at build time so the dashboard can call the API.
APP_TOKEN=
VITE_APP_TOKEN=

# Optional. Render injects PORT automatically; defaults to 3000 locally.
PORT=3000

# CollegeBoard BigFuture login — NO LONGER READ FROM HERE.
# It now lives in the macOS Keychain (see identity/secrets.ts). One-time setup:
#   security add-generic-password -a "$USER" -s ccp_cb_username -w
#   security add-generic-password -a "$USER" -s ccp_cb_password -w
# The old CB_USERNAME / CB_PASSWORD env vars still work as a fallback but warn on use;
# delete them from your .env once the Keychain entries exist.
